{
  "manifest_version": 3,
  "name": "Cookie Shooter",
  "version": "1.0.0",
  "description": "Turn the cookies on any page into enemies and its buttons and boxes into breakable walls.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Shooter",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [{ "resources": ["fonts/*"], "matches": ["<all_urls>"] }]
}
